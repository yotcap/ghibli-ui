{
  "name": "ghibli-ui",
  "version": "0.1.0",
  "description": "A warm, storybook-style React component library inspired by Studio Ghibli",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yotcap/ghibli-ui"
  },
  "homepage": "https://github.com/yotcap/ghibli-ui#readme",
  "bugs": {
    "url": "https://github.com/yotcap/ghibli-ui/issues"
  },
  "author": "yotcap",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "ui",
    "ghibli",
    "studio-ghibli",
    "component-library",
    "typescript",
    "storybook-style"
  ],
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.263.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "less": "^4.1.3",
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
